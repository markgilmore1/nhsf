# Server-side includes: lets pages pull in the shared header, nav and footer
# from /partials/ with <!--#include virtual="/partials/..." -->.
# IncludesNOEXEC allows includes but not running commands from them.
Options +IncludesNOEXEC
AddType text/html .htm .html
AddOutputFilter INCLUDES .htm .html

# Retired page: /index2011.htm was a stray old copy of the 2008 newsletter index.
# Send anyone with an old link or bookmark to the real 2011 newsletter page.
Redirect 301 /index2011.htm /newsletters/Yearly%20index%20files/2011/index2011.htm
